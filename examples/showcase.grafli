#!grafli v1
# grafli feature showcase — source for the v0.1.0 docs-site screenshots.
#
# Theme: NPC behaviors in a fantasy town.
#
# Three spatially-separated regions, framed independently for each shot:
#   Region 1 (y ≈ 0)     — hero: a baker's daily routine (state machine)
#   Region 2 (y ≈ 900)   — annotations: a guard's threat-reaction behavior
#                          under design review
#   Region 3 (y ≈ 1900)  — dense graph: town-wide NPC ecosystem, reused
#                          for the heatmap and jump-labels shots
#
# Open: grafli examples/showcase.grafli — select an element in the region
# you want to capture and press Z to fit-zoom.

# ============================================================
# Region 1 — Baker's day (hero)
# ============================================================

@ note title1 60,0 "Baker's day" ~xxlarge

@ note caption1 60,110 "A daily routine as a state machine.\nEach arrow's `step:` / `state:` / `event:` prefix renders as a colored chip on the edge." ~small

@ box sleep "Sleep" 60,180 160x90 %subtle
@ box bake "Bake bread" 240,180 180x90 %accent
@ box shop "Open shop" 440,180 180x90 %tertiary
@ box lunch "Lunch" 640,180 160x90 %highlight
@ box deliver "Deliver" 820,180 200x90 %tertiary
@ box dinner "Dinner" 1040,180 160x90 %accent

@ arrow sleep -> bake "step: 06:00"
@ arrow bake -> shop "state: ready"
@ arrow shop -> lunch "event: hungry"
@ arrow lunch -> deliver "step: 15:00"
@ arrow deliver -> dinner "step: 20:00"
@ arrow dinner -> sleep "step: 22:00"

@ note bake_code 240,310 "code:\nfn: bake() -> Bread\nif: flour < 1\nthen: err OutOfFlour\nset: dough = mix(flour, water, yeast)\nstate: rising -> baking\nemit: BatchReady\nreturn: bread"
@ arrow bake_code -- bake

@ note qa_flour 1040,320 "Q: what if flour runs out mid-bake?\nA: the `code:` note bails — `if: flour < 1` raises OutOfFlour and ends the routine for the day."

# ============================================================
# Region 2 — Threat reaction (annotations)
# ============================================================

@ note title2 60,900 "Threat reaction" ~xxlarge

@ note caption2 60,970 "Behavior under review. `T:` tasks, `Q:` questions, threaded discussions, and `code:` notes live next to the boxes they describe." ~small

@ box sense "Sense threat" 60,1000 220x90 %secondary
@ box assess "Assess danger" 340,1000 240x90 %accent
@ box flee "Flee" 680,1000 180x90 %muted
@ box fight "Fight" 680,1120 180x90 %accent
@ box guards "Call guards" 680,1240 200x90 %tertiary
@ box hide "Hide" 920,1000 180x90 %muted

@ arrow sense -> assess "call: classify"
@ arrow assess -> flee "event: weak"
@ arrow assess -> fight "event: strong"
@ arrow assess -> guards "event: many"
@ arrow flee -> hide "step: refuge"
@ arrow guards -> fight "verify: backup" !dashed
@ arrow fight -> flee "risk: outnumbered" !dashed
@ arrow hide -> assess "verify: clear" !dashed

@ note todo 60,1340 "T: add audible cue when sense triggers"
@ note q1 340,1340 "Q: should fear scale with NPC level?"
@ note disc 1140,1000 "Designer: Should child NPCs ever pick fight?\nReviewer: No — clamp to flee/hide when AgeTag is child.\nDesigner: Will add the tag check inside assess."
@ note qa_recover 1140,1240 "Q: should Hide auto-recover after a timer?\nA: no — only on `verify: clear` from assess. A timer risks re-engaging an active threat."
@ note assess_code 60,1460 "code:\nfn: assessDanger(npc, threat) -> Action\nset: ratio = threat.power / npc.power\nif: ratio > 2.0\nthen: return flee\nif: threat.count > npc.allies\nthen: return guards\nverify: tests/test_assess.py:matrix\nreturn: fight  @ai/threat.py:88"
@ arrow assess_code -- assess

# ============================================================
# Region 3 — Town life (heatmap + jump-labels)
# ============================================================

@ note title3 60,1900 "Town life" ~xxlarge

@ note caption3 980,1980 "NPCs `owns:` a shift,\n`step:` through routines,\nreact to world `event:`s.\nPress A for the heatmap." ~small

# NPCs (column 1)
@ box baker "Baker" 60,1980 180x80 %accent
@ box smith "Smith" 60,2080 180x80 %accent
@ box innkeep "Innkeeper" 60,2180 180x80 %accent
@ box guard "Guard" 60,2280 180x80 %accent
@ box priest "Priest" 60,2380 180x80 %accent

# Workplaces (column 2)
@ box bakery "Bakery" 300,1980 180x80 %tertiary
@ box smithy "Smithy" 300,2080 180x80 %tertiary
@ box inn "Inn" 300,2180 180x80 %tertiary
@ box gate "Town gate" 300,2280 180x80 %tertiary
@ box temple "Temple" 300,2380 180x80 %tertiary

# Shared spaces (column 3)
@ box market "Market" 540,2030 180x80 %highlight
@ box square "Town square" 540,2180 180x80 %highlight
@ box well "Village well" 540,2330 180x80 %highlight

# Events (column 4)
@ box festival "Festival" 780,1980 180x80 %primary
@ box raid "Bandit raid" 780,2180 180x80 %primary
@ box trade "Trade day" 780,2380 180x80 %primary

# Each NPC owns a daily shift at their workplace
@ arrow baker -> bakery "owns: shift"
@ arrow smith -> smithy "owns: shift"
@ arrow innkeep -> inn "owns: shift"
@ arrow guard -> gate "owns: patrol"
@ arrow priest -> temple "owns: shift"

# Routine visits to shared spaces
@ arrow baker -> market "step: morning"
@ arrow smith -> market "step: morning"
@ arrow innkeep -> market "step: dawn"
@ arrow guard -> square "step: evening"
@ arrow priest -> square "step: sermon"
@ arrow priest -> well "step: blessing"

# Events ripple through NPCs
@ arrow festival -> baker "event: bake_cake"
@ arrow festival -> innkeep "event: extra_ale"
@ arrow festival -> priest "event: blessing"
@ arrow festival -> guard "event: crowd_watch"
@ arrow raid -> guard "event: defend"
@ arrow raid -> baker "event: hide"
@ arrow raid -> priest "event: shelter"
@ arrow trade -> smith "event: stock_tools"
@ arrow trade -> innkeep "event: extra_rooms"

@ note qa_busiest 980,2280 "Q: who is the busiest NPC?\nA: Priest — temple shift + well + square + festival + raid. Five edges, the brightest hotspot in the heatmap."
@ note n1 955.472573114052,470.5702422586706 "question: what is this?"
@ note n2 963.8329581288,566.1174995700758 "todo: Let's refine this one!"
@ note n3 1336.4672616432802,578.0609067340015 "Some text ..."
@ box box1 "A Node" 460,640 160x80 %primary
@ box box2 "A Node" 660,640 160x80 %tertiary
@ box box3 "A Node" 535.085468942171,822.3139972354319 160x80 %muted
@ arrow box1 -> box3 "risk: not this"
@ arrow box2 -> box3 "data: some info"
