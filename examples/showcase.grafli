#!grafli v1
# grafli feature showcase — source for the v0.1.0 docs-site screenshots.
#
# Theme: NPC behaviors in a fantasy town.
#
# Three spatially-separated regions, framed independently for each shot:
#   Region 1 (y ≈ 0)     — hero: a baker's daily routine (state machine)
#   Region 2 (y ≈ 900)   — annotations: a guard's threat-reaction behavior
#                          under design review
#   Region 3 (y ≈ 1900)  — dense graph: town-wide NPC ecosystem, reused
#                          for the heatmap and jump-labels shots
#
# Open: grafli examples/showcase.grafli — select an element in the region
# you want to capture and press Z to fit-zoom.

# ============================================================
# Region 1 — Baker's day (hero)
# ============================================================

@ note title1 1477,19 "Baker's day" ~xxlarge

@ note caption1 -301,-109 """
A daily routine as a state machine.
Each arrow's `step:` / `state:` / `event:` prefix renders as a colored chip on the edge.
""" ~small

@ box sleep "Sleep" 140,142 160x90 %subtle
@ box bake "Bake bread" 126,390 180x90 %accent
@ box shop "Open shop" 479,506 180x90 %tertiary
@ box lunch "Lunch" 874,391 160x90 %highlight
@ box deliver "Deliver" 846,147 200x90 %tertiary
@ box dinner "Dinner" 482,29 160x90 %accent

@ arrow sleep -> bake "step: 06:00"
@ arrow bake -> shop "state: ready"
@ arrow shop -> lunch "event: hungry"
@ arrow lunch -> deliver "step: 15:00"
@ arrow deliver -> dinner "step: 20:00"
@ arrow dinner -> sleep "step: 22:00"

@ note bake_code 434,218 """
code:
bake() -> Bread
if flour < 1
   err OutOfFlour
dough = mix(flour, water, yeast)
state rising -> baking
emit BatchReady
return bread
"""
@ arrow bake_code -- bake

@ note qa_flour 1400,380 """
Q: what if flour runs out mid-bake?
A: the `code:` note bails — `if: flour < 1` raises OutOfFlour and ends the routine for the day.
""" ~width=61

# ============================================================
# Region 2 — Threat reaction (annotations)
# ============================================================

@ note title2 -38,719 "Threat reaction" ~xxlarge

@ note caption2 -43,782 "Behavior under review. `T:` tasks, `Q:` questions, threaded discussions, and `code:` notes live next to the boxes they describe." ~small

@ box sense "Sense threat" -64,993 220x90 %subtle
@ box assess "Assess danger" 340,1001 240x90 %accent &graph:assess
@ box flee "Flee" 874,1028 180x90 %muted
@ box fight "Fight" 670,1249 180x90 %accent
@ box guards "Call guards" 347,1375 200x90 %tertiary
@ box hide "Hide" 874,819 180x90 %muted &doc:hide

@ arrow sense -> assess "call: classify"
@ arrow assess -> flee "event: weak"
@ arrow assess -> fight "event: strong" !ortho
@ arrow assess -> guards "event: many"
@ arrow flee -> hide "step: refuge"
@ arrow guards -> fight "verify: backup" !dashed !spline
@ arrow fight -> flee "risk: outnumbered" !dashed !spline
@ arrow hide -> assess "verify: clear" %primary !dashed !spline

@ note todo -6,1341 "T: add audible cue when sense triggers"
@ note q1 351,1491 "Q: should fear scale with NPC level?"
@ note disc 769,1384 """
Designer: Should child NPCs ever pick fight?
Reviewer: No — clamp to flee/hide when AgeTag is child.
Designer: Will add the tag check inside assess.
""" ~width=54
@ note qa_recover 410,840 """
Q: should Hide auto-recover after a timer?
A: no — only on `verify: clear` from assess. 
A timer risks re-engaging an active threat.
""" ~width=47
@ note assess_code -2,1131 """
code:
assessDanger(npc, threat) -> Action
ratio = threat.power / npc.power
if ratio > 2.0
   return flee
if threat.count > npc.allies
   return guards
verify tests/test_assess.py:matrix
return fight  @ai/threat.py:88
""" ~width=38
@ arrow assess_code -- assess

# ============================================================
# Region 3 — Town life (heatmap + jump-labels)
# ============================================================

@ note title3 -440,1640 "Town life" ~xxlarge ~width=10

@ note caption3 -435,1804 """
NPCs `owns:` a shift,
`step:` through routines,
react to world `event:`s.
Press A for the heatmap.
""" ~small ~width=39

# NPCs (column 1)
@ box baker "Baker" -31,1831 180x80 %accent
@ box smith "Smith" -21,2001 180x80 %accent
@ box innkeep "Innkeeper" 43,2224 180x80 %accent
@ box guard "Guard" 41,2347 180x80 %accent
@ box priest "Priest" 39,2596 180x80 %accent

# Workplaces (column 2)
@ box bakery "Bakery" 289,1847 161x63 %tertiary
@ box smithy "Smithy" 170,2127 180x80 %tertiary
@ box inn "Inn" -259,2183 180x80 %tertiary
@ box gate "Town gate" 44,2475 180x80 %tertiary
@ box temple "Temple" -400,2600 180x80 %tertiary

# Shared spaces (column 3)
@ box market "Market" -455,1916 180x80 %highlight
@ box square "Town square" -480,2386 180x80 %highlight
@ box well "Village well" 502,2583 180x80 %highlight

# Events (column 4)
@ box festival "Festival" 652,2332 180x80 %primary
@ box raid "Bandit raid" -479,2220 180x80 %primary
@ box trade "Trade day" 580,2020 180x80 %primary

# Each NPC owns a daily shift at their workplace
@ arrow baker -> bakery "owns: shift"
@ arrow smith -> smithy "owns: shift"
@ arrow innkeep -> inn "owns: shift"
@ arrow guard -> gate "owns: patrol"
@ arrow priest -> temple "owns: shift"

# Routine visits to shared spaces
@ arrow baker -> market "step: morning"
@ arrow smith -> market "step: morning"
@ arrow innkeep -> market "step: dawn"
@ arrow guard -> square "step: evening"
@ arrow priest -> square "step: sermon"
@ arrow priest -> well "step: blessing"

# Events ripple through NPCs
@ arrow festival -> baker "event: bake_cake"
@ arrow festival -> innkeep "event: extra_ale"
@ arrow festival -> priest "event: blessing"
@ arrow festival -> guard "event: crowd_watch"
@ arrow raid -> guard "event: defend"
@ arrow raid -> baker "event: hide"
@ arrow raid -> priest "event: shelter"
@ arrow trade -> smith "event: stock_tools"
@ arrow trade -> innkeep "event: extra_rooms"

@ note qa_busiest -220,1720 """
Q: who is the busiest NPC?
A: Priest — temple shift + well + square + festival + raid. 
Five edges, the brightest hotspot in the heatmap.
""" ~width=106
@ arrow disc -> fight
@ note n1 1400,300 "This is some interesting text which is quite long but I want to have it wrapping among multiple lines, does this work?" ~width=61
