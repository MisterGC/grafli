# --- Infrastructure ---
@ box k8s "Kubernetes Cluster" 250,940 200x80 #E91E63
@ box monitor "Prometheus + Grafana Monitoring Stack" 500,940 230x80 #E91E63
@ box ci "CI/CD Pipeline (GitHub Actions)" 866.6054404145074,968.4668393782378 220x80 #E91E63

# --- Frontend to API ---
@ arrow web -> gateway
@ arrow mobile -> gateway
@ arrow admin -> graphql

# --- API to Services ---
@ arrow gateway -> auth "verify"
@ arrow gateway -> users
@ arrow gateway -> orders
@ arrow graphql -> users
@ arrow graphql -> orders
@ arrow graphql -> catalog

# --- Services to Events ---
@ arrow orders -> queue "publish"
@ arrow queue -> notify "consume"
@ arrow queue -> search "index"
@ arrow catalog -> search "sync"

# --- Services to Data ---
@ arrow auth -> redis "sessions"
@ arrow users -> postgres "read/write"
@ arrow orders -> postgres "transactions"
@ arrow catalog -> mongo "documents"
@ arrow orders -> s3 "invoices"

# --- Infrastructure ---
@ arrow k8s -> monitor "metrics"
@ arrow ci -> k8s "deploy"

# --- Notes ---
@ note 0,220 "Rate limited: 10k req/s"
@ note 720,220 "Schema stitching from all services"
@ note 0,580 "Event-driven architecture"
@ note 250,860 "All services containerized"
