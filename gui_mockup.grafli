#!grafli v1
# Address Form — GUI Mockup

@ box window "Address Form" 40,30 460x580 #4285F4 ^topleft ~small

@ note 60,75 "First Name"
@ box inp_first "" 60,100 190x39 #FFFFFF >window

@ note 270,75 "Last Name"
@ box inp_last "" 270,100 210x39 #FFFFFF >window

@ note 60,160 "Street Address"
@ box inp_street "" 60,185 420x39 #FFFFFF >window

@ note 60,245 "Apt / Suite"
@ box inp_apt "" 60,270 130x39 #FFFFFF >window

@ note 210,245 "City"
@ box inp_city "" 210,270 270x39 #FFFFFF >window

@ note 60,330 "State"
@ box inp_state "" 60,355 180x39 #FFFFFF >window

@ note 260,330 "ZIP Code"
@ box inp_zip "" 260,355 100x39 #FFFFFF >window

@ note 60,415 "Country"
@ box inp_country "United States" 60,440 420x39 #FFFFFF >window

@ box btn_cancel "Cancel" 260,510 100x40 >window
@ box btn_save "Save" 380,510 100x40 #4285F4 >window

@ box mapwin "Map Viewer" 559,28 460x580 #F9AB00 ^topleft ~small

@ note 580,75 "Search Location"
@ box inp_search "" 579,98 420x39 #FFFFFF >mapwin

@ box map_area "" 579,158 420x340 #FFFFFF >mapwin
@ note 720,310 "[ Map Display ]" #5F6368

@ note 580,520 "Lat"
@ box inp_lat "" 579,543 130x39 #FFFFFF >mapwin
@ note 730,520 "Lng"
@ box inp_lng "" 729,543 130x39 #FFFFFF >mapwin

@ box btn_locate "Locate" 879,538 100x40 #34A853 >mapwin

@ arrow btn_save -> mapwin "geocode"

@ note 1148,3 "User Interaction Flow" #5F6368

@ box step1 "1. Fill address fields" 1148,33 220x40
@ box step2 "2. Click Save" 1148,93 220x40
@ box step3 "3. Geocode address" 1148,153 220x40
@ box step4 "4. Map updates with pin" 1148,213 220x40
@ box step5 "5. Review coordinates" 1148,273 220x40
@ box step6 "6. Click Locate to refine" 1148,333 220x40
@ box step7 "7. Updated address saved" 1148,393 220x40

@ arrow step1 -> step2
@ arrow step2 -> step3
@ arrow step3 -> step4
@ arrow step4 -> step5
@ arrow step5 -> step6
@ arrow step6 -> step7

@ arrow step2 -> btn_save "triggers"
@ arrow step3 -> map_area "displays"
@ arrow step6 -> btn_locate "triggers"