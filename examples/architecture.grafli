#!grafli v1
# Shop architecture — who owns what, who talks to whom on the order path.
# Genre exemplar: architecture (references/genres.md → Software diagrams).
# Containers = ownership; every edge carries a semantic prefix; depth lives
# in the code note and the &graph sub-board on Order Processing.

@ note title 340,-70 "Shop architecture — the order path" ~xlarge
@ note subtitle 344,-10 "who owns what · who talks to whom" ~small !italic

# ── clients ──
@ box clients "Clients" 40,80 540x220 %secondary ^topleft ~large !flat
@ box web "Web App\nReact + Next.js" 70,130 220x80 %secondary >clients
@ box mobile "Mobile App\nReact Native" 330,200 220x80 %secondary >clients

# ── API boundary ──
@ box api "API boundary" 660,80 500x220 %primary ^topleft ~large !flat
@ box gateway "API Gateway\nrate limits + auth" 690,150 200x90 %primary >api
@ box graphql "GraphQL Federation\nschema stitching" 920,150 190x90 %primary &doc:graphql >api
@ note n_api_task 690,252 "T: add p95 latency budget to gateway → graphql" ~small >api

# ── core domain services ──
@ box core "Core domain services" 40,400 1100x230 %tertiary ^topleft ~large !flat
@ box auth "Auth Service\nOAuth2 + JWT" 80,480 220x90 %tertiary >core
@ box users "User Profile\nService" 340,480 220x90 %tertiary >core
@ box orders "Order Processing\n& Fulfillment" 600,480 240x90 %tertiary &graph:orders-flow >core
@ box catalog "Product Catalog\nService" 880,480 220x90 %tertiary >core

# ── data & external stores ──
@ box data "Data and external stores" 40,730 1100x230 %subtle ^topleft ~large !flat
@ box redis "Redis\nsessions/cache" 80,810 220x85 %subtle >data
@ box postgres "PostgreSQL\nprimary store" 340,810 220x85 %subtle >data
@ box queue "Kafka\norder events" 600,810 240x85 %subtle >data
@ box search "Search Index\nElasticsearch" 880,810 220x85 %subtle >data

# ── depth: the one non-obvious algorithm ──
@ note n_place_order 1220,430 """
code:
placeOrder(req) -> OrderId
pre: req.user is authenticated
call: inventory.reserve(req.items)
try:
  call: payment.authorize(req.total)
  emit: OrderCreated(order.id)
catch: PaymentDeclined -> err: reject order
post: audit trail includes "order.created"
verify: test_order_happy_path @tests/orders_test.py:41
risk: reservation leak if payment timeout is not compensated
""" ~small !mono
@ arrow n_place_order -> orders !dotted

# ── clients → API ──
@ arrow web -> gateway "call: /api" @0,-20
@ arrow mobile -> gateway "call: /mobile" @0,26
@ arrow gateway -> graphql

# ── API → core ──
@ arrow gateway -> auth "verify: JWT" @-16,40
@ arrow gateway -> users "call: profile lookup" @-10,96
@ arrow graphql -> users "data: user fields" @16,40
@ arrow graphql -> orders "call: resolve order" @14,96
@ arrow graphql -> catalog "call: resolve products" @0,16
@ arrow graphql -> orders "risk: N+1 resolver path" @40,30 !dashed

# ── core → data / events ──
@ arrow auth -> redis "owns: sessions"
@ arrow users -> postgres "data: profile rows" @-34,-16
@ arrow orders -> postgres "data: order txn" @6,0
@ arrow orders -> queue "event: OrderCreated"
@ arrow catalog -> search "event: ProductIndexed"
@ arrow queue -> search "depends: consumer" @0,58
